# Paceboard configuration. Copy to .env and edit:
#     cp .env.example .env && chmod 600 .env
#
# .env is git-ignored. Never commit real credentials.

# ---------------------------------------------------------------------------
# Garmin
# ---------------------------------------------------------------------------
# Garmin data reaches Paceboard only through the read-only Garmin MCP server in
# this repository. Start it with ./scripts/garmin-mcp-readonly.sh
GARMIN_MCP_URL=http://127.0.0.1:8000/mcp
# Per-call timeout, bounded concurrency and retry budget for that server.
GARMIN_MCP_TIMEOUT=120
GARMIN_MCP_CONCURRENCY=3
GARMIN_MCP_MAX_RETRIES=3

# ---------------------------------------------------------------------------
# Paceboard runtime
# ---------------------------------------------------------------------------
# Loopback only. This API serves personal health data and has no authentication.
PACEBOARD_HOST=127.0.0.1
PACEBOARD_API_PORT=8787
PACEBOARD_WEB_PORT=3000
PACEBOARD_TIMEZONE=Europe/Oslo
PACEBOARD_UNIT_SYSTEM=metric
PACEBOARD_DATABASE_PATH=./data/paceboard.sqlite3
PACEBOARD_LOG_LEVEL=INFO

# Binding to anything other than loopback is refused unless you set this, and
# even then the API stays unauthenticated. Put a reverse proxy with auth in
# front of it before you consider this.
# PACEBOARD_ALLOW_NON_LOOPBACK=false

# ---------------------------------------------------------------------------
# Sync behaviour
# ---------------------------------------------------------------------------
PACEBOARD_BACKFILL_DAYS=90
PACEBOARD_RECONCILE_DAYS=3
PACEBOARD_SCHEDULER_ENABLED=true
# Today's health and recent activities.
PACEBOARD_FAST_INTERVAL_MINUTES=15
# Local hour for the daily reconciliation and long-term trend refresh.
PACEBOARD_DAILY_HOUR_LOCAL=4

# Cross-provider duplicate matching tolerances.
PACEBOARD_DEDUPE_START_TOLERANCE_SECONDS=300
PACEBOARD_DEDUPE_DURATION_TOLERANCE_PCT=0.05
PACEBOARD_DEDUPE_DISTANCE_TOLERANCE_PCT=0.05

# ---------------------------------------------------------------------------
# Strava (optional — Paceboard works fully on Garmin data without it)
# ---------------------------------------------------------------------------
# Create an application at https://www.strava.com/settings/api
#   Website                       -> http://127.0.0.1:3000  (cosmetic; never fetched)
#   Authorization Callback Domain -> 127.0.0.1              (domain only: no scheme,
#                                                            no port, no path)
# Use 127.0.0.1 rather than localhost: Strava treats them as different hosts, and
# it must match the host in STRAVA_REDIRECT_URI below.
STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=
STRAVA_REDIRECT_URI=http://127.0.0.1:8787/api/v1/auth/strava/callback
# Polling interval used when webhooks are not available (the normal local case).
STRAVA_POLL_MINUTES=60
# Only needed if you expose the API through a tunnel and register a webhook.
STRAVA_WEBHOOK_VERIFY_TOKEN=

# ---------------------------------------------------------------------------
# Storage paths (defaults are fine)
# ---------------------------------------------------------------------------
# PACEBOARD_TOKEN_PATH=./data/strava_tokens.json
# PACEBOARD_SECRET_KEY_PATH=./data/paceboard.key

# ---------------------------------------------------------------------------
# Development only
# ---------------------------------------------------------------------------
# Fills the dashboard with clearly labelled synthetic data and shows a banner.
# Never point this at a database holding real data.
# PACEBOARD_FIXTURE_MODE=false
